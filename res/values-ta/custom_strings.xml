    <string name="columbus_target_request_dialog_title">%1$s ஆப்ஸைத் திறக்க, விரைவுத் தட்டல் சைகையை அனுமதிக்கவா?</string>
    <string name="columbus_target_request_dialog_summary">%1$s ஆப்ஸைத் திறக்க மொபைலின் பின்புறத்தில் இருமுறை தட்டுங்கள். அமைப்புகளில் இதை எப்போது வேண்டுமானாலும் மாற்றிக்கொள்ளலாம்.</string>
    <string name="columbus_target_request_dialog_allow">அனுமதி</string>
    <string name="columbus_target_request_dialog_deny">அனுமதிக்காதே</string>

    <!-- Battery Warnings -->
    <string name="low_battery_notification_title">%s பேட்டரி மீதமுள்ளது</string>
    <string name="low_battery_notification_text">பேட்டரி ஆயுளை நீட்டிக்க பேட்டரி சேமிப்பு அம்சத்தை இயக்குங்கள்</string>
    <string name="low_battery_notification_text_ebs">பேட்டரி ஆயுளை நீட்டிக்க மேம்பட்ட பேட்டரி சேமிப்பானை இயக்குங்கள்</string>
    <string name="severe_battery_notification_title">%s பேட்டரி மீதமுள்ளது</string>
    <string name="severe_battery_notification_text">மேம்பட்ட பேட்டரி சேமிப்பானை இயக்கவா? இது அனைத்து அத்தியாவசியமற்ற ஆப்ஸையும் இடைநிறுத்தும்</string>
    <string name="severe_battery_notification_switch_text">மேம்பட்ட பேட்டரி சேமிப்பான் அம்சத்திற்கு மாற்றவா? \n\nஇது அனைத்து அத்தியாவசியமற்ற ஆப்ஸையும் அவற்றின் அறிவிப்புகளையும் இடைநிறுத்தும்</string>
    <string name="severe_low_battery_dialog_switch_action_text">மாற்று</string>
    <string name="extreme_low_battery_notification_title">பேட்டரி மிகக் குறைவாக உள்ளது</string>
    <string name="extreme_low_battery_notification_text">உங்கள் மொபைலை விரைவில் சார்ஜ் செய்யவில்லை எனில் அது ஷட் டவுன் ஆகிவிடும்</string>

    <!-- Battery Saver Confirmation Dialog -->
    <string name="saver_confirmation_dialog_title">பேட்டரி சேமிப்பான் அம்சத்திற்கு வரவேற்கிறோம்</string>
    <string name="saver_confirmation_dialog_subtitle">பயன்படுத்துவதற்கான மோடைத் தேர்ந்தெடுக்கவும்</string>
    <string name="saver_confirmation_dialog_title_standard_mode">இயல்புநிலை பேட்டரி சேமிப்பு</string>
    <string name="saver_confirmation_dialog_summary_standard_mode">விஷுவல் எஃபெக்ட்டுகளையும் பின்னணிச் செயல்பாடுகளையும் குறைக்கும். டார்க் தீம் ஏற்கெனவே ஆன் செய்யப்படவில்லை என்றால் அதை ஆன் செய்யும்.</string>
    <string name="saver_confirmation_dialog_title_extreme_mode">மேம்பட்ட பேட்டரி சேமிப்பான்</string>
    <string name="saver_confirmation_dialog_summary_extreme_mode">மேலே பட்டியலிடப்பட்டுள்ள அனைத்து மாற்றங்களும் அடங்கும். அத்துடன், அத்தியாவசியமற்ற ஆப்ஸையும் அவற்றின் அறிவிப்புகளையும் இடைநிறுத்தும்.</string>
    <string name="saver_confirmation_dialog_dismiss_text">ரத்துசெய்</string>
    <string name="face_reenroll_dialog_confirm">அமை</string>

    <!-- Adaptive Charging -->
    <string name="adaptive_charging_notify_title">சூழலுக்கேற்பச் சார்ஜ் செய்தல் அம்சம் இயக்கப்பட்டுள்ளது</string>
    <string name="adaptive_charging_notify_des">%1$sக்கு பேட்டரி முழுமையாகச் சார்ஜாகிவிடும். பேட்டரி ஆயுட்காலத்தை நீட்டிக்க சீராகச் சார்ஜ் செய்யப்படுகிறது.</string>
    <string name="adaptive_charging_notify_turn_off_once">ஒருமுறை முடக்கு</string>
    <string name="adaptive_charging_time_estimate">%1$s • அடாப்டிவ் சார்ஜிங் • %2$sக்கு முழுமையாகச் சார்ஜாகிவிடும்</string>

    <!-- Charge Limit -->
    <string name="charge_limit_discovery_notification_title">சார்ஜ் செய்யும்போது உங்கள் பேட்டரியைப் பாதுகாத்தல்</string>
    <string name="charge_limit_discovery_notification_text">பேட்டரி நிலையையும் ஆயுட்காலத்தையும் பாதுகாக்க 80% வரம்பு அம்சத்தை இயக்க முயலவும். நீங்கள் எப்போது வேண்டுமானாலும் இதை அமைப்புகளில் நிர்வகிக்கலாம்.</string>
    <string name="charge_limit_discovery_notification_enable_button">இப்போதே இயக்கு</string>
    <string name="battery_health_notify_learn_more">மேலும் அறிக</string>
    <string name="keyguard_indication_charging_time_charge_limit">%2$s • %1$sக்குச் சார்ஜாகிவிட்டது</string>
    <string name="keyguard_indication_charging_time_charge_limit_v1">%2$s • %1$s இல் சார்ஜாகிவிட்டது</string>
