    <string name="severe_battery_notification_switch_text">மேம்பட்ட பேட்டரி சேமிப்பான் அம்சத்திற்கு மாற்றவா? \n\nஇது அனைத்து அத்தியாவசியமற்ற ஆப்ஸையும் அவற்றின் அறிவிப்புகளையும் இடைநிறுத்தும்</string>
    <string name="severe_low_battery_dialog_switch_action_text">மாற்று</string>
    <string name="extreme_low_battery_notification_title">பேட்டரி மிகக் குறைவாக உள்ளது</string>
    <string name="extreme_low_battery_notification_text">உங்கள் மொபைலை விரைவில் சார்ஜ் செய்யவில்லை எனில் அது ஷட் டவுன் ஆகிவிடும்</string>

    <!-- Quick Tap -->
    <string name="columbus_bouncer_message">விரைவுத் தட்டல் சைகையை நிறைவுசெய்ய அன்லாக் செய்யவும்</string>
