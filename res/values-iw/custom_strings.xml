    <string name="saver_confirmation_dialog_dismiss_text">ביטול</string>
    <string name="face_reenroll_dialog_confirm">הגדרה</string>

    <!-- Adaptive Charging -->
    <string name="adaptive_charging_notify_title">הטעינה הדינמית מופעלת</string>
    <string name="adaptive_charging_notify_des">הסוללה תיטען במלואה עד %1$s. מתבצעת טעינה אחידה כדי להאריך את משך חיי הסוללה.</string>
    <string name="adaptive_charging_notify_turn_off_once">השבתה פעם אחת</string>
    <string name="adaptive_charging_time_estimate">‫%1$s • טעינה דינמית • טעינה מלאה עד %2$s</string>

    <!-- Charge Limit -->
    <string name="charge_limit_discovery_notification_title">הגנה על הסוללה בזמן הטעינה</string>
    <string name="charge_limit_discovery_notification_text">מומלץ להפעיל את תכונת ההגבלה ל-80% כדי להגן על תקינות הסוללה ועל תוחלת החיים שלה. אפשר לנהל את זה ב\'הגדרות\' בכל שלב</string>
    <string name="charge_limit_discovery_notification_enable_button">להפעלה</string>
    <string name="battery_health_notify_learn_more">מידע נוסף</string>
    <string name="keyguard_indication_charging_time_charge_limit">‫%2$s • טעינה מלאה עד %1$s</string>
    <string name="keyguard_indication_charging_time_charge_limit_v1">‫%2$s • הטעינה תסתיים בעוד %1$s</string>
    <string name="keyguard_indication_charging_time_reach_charge_limit">‫%1$s • הטעינה הסתיימה</string>

    <!-- Battery Health Assistance -->
    <string name="pulsar_enabled_notification_title">הסיוע לתקינות הסוללה פועל</string>
    <string name="pulsar_enabled_notification_text">‏עכשיו Pixel עוזר לך לשמור על התקינות והביצועים של הסוללה לאורך זמן. אפשר להשבית את התכונה הזו בהגדרות.</string>
    <string name="pulsar_reminder_notification_title">התכונה \"עזרה בנושא תקינות הסוללה\" מושבתת</string>
    <string name="pulsar_reminder_notification_text">כדי לשמור על התקינות והביצועים של הסוללה לאורך זמן, צריך להפעיל את התכונה \"עזרה בנושא תקינות הסוללה\".</string>

    <!-- Battery Defender -->
    <string name="temp_defender_notify_title">הטעינה מוגבלת כדי להגן על הסוללה</string>
    <string name="temp_defender_notify_des">הסוללה הייתה חמה במשך זמן רב. הטעינה הרגילה תתחדש כשהסוללה תתקרר עוד יותר</string>
    <string name="dwell_defender_notify_title">הטעינה הושהתה כדי להגן על הסוללה</string>
    <string name="dwell_defender_notify_des">הפעולה הזו מאפשרת להאריך את משך חיי הסוללה כשהטלפון נשאר בטעינה יותר מדי זמן</string>
    <string name="defender_notify_title">הגנה על הסוללה</string>
    <string name="defender_notify_resume_charge">אני רוצה להטעין בכל זאת</string>
    <string name="defender_post_notify_title">הטעינה הוגבלה כדי להגן על הסוללה</string>
    <string name="defender_post_notify_des">כדי להאריך את משך חיי הסוללה, הטעינה הוגבלה מהשעה %1$s עד השעה %2$s</string>
    <string name="dock_defender_first_run_title">הטעינה הושהתה כדי להגן על הסוללה</string>
    <string name="dock_defender_first_run_des">"כדי לשפר את משך חיי הסוללה, הטעינה מושהית כשהסוללה מגיעה ל-90% בזמן שהטבאלט באביזר העגינה. אפשר לעבור ל'הגדרות' בכל שלב כדי לשנות מברירת המחדל."</string>
    <string name="dock_defender_first_run_settings">הגדרות</string>

    <!-- Incompatible Charging -->
    <string name="incompatible_charging_notify_title">בדיקה של אביזר הטעינה</string>
    <string name="incompatible_charging_notify_des">יכול להיות שהטלפון נטען לאט או לא נטען. לטעינה מהירה יותר, כדאי להשתמש במתאם ובכבל מומלצים.</string>
    <string name="incompatible_charging_learn_more">מידע נוסף</string>

    <!-- Wireless Charging -->
    <string name="wireless_charging_notification_title">טעינה אלחוטית</string>
    <string name="wireless_charging_notification_text">טעינה אלחוטית עשויה לצרוך יותר חשמל מאשר טעינה חוטית. כדי לחסוך בחשמל ובזמן, כדאי להחליף למטען חוטי.</string>

    <!-- Shutdown Mode -->
    <string name="shutdown_mode_screen_title">הטלפון חם מדי</string>
    <string name="shutdown_mode_screen_description">הטלפון עבר זמנית למצב חיסכון בסוללה כדי להתקרר. הוא יהיה מוכן לשימוש כשהוא יתקרר.</string>
    <string name="shutdown_mode_screen_shutdown_button_text">כיבוי</string>
    <string name="shutdown_confirmation_dialog_title">לכבות את הטלפון?</string>
    <string name="shutdown_confirmation_dialog_description">אחרי שהמכשיר יתקרר, יהיה צריך להפעיל אותו מחדש.</string>
    <string name="shutdown_confirmation_dialog_confirm">כיבוי</string>
    <string name="shutdown_confirmation_dialog_cancel">ביטול</string>
    <string name="post_shutdown_mode_dialog_title">הטלפון התחמם ולכן עבר למצב חיסכון בסוללה</string>
    <string name="post_shutdown_mode_dialog_description">"הוא כבר התקרר ועכשיו הכול פועל כרגיל.

סיבות להתחממות יתר:
\t• משתמשים בו לפעילויות שמכבידות על הסוללה, כמו צפייה בסרטונים, גיימינג וניווט
\t• מורידים או מעלים קבצים גדולים
\t• הוא חשוף לאור שמש ישיר"</string>
    <string name="post_shutdown_mode_dialog_learn_more_button_text">מידע נוסף</string>

    <!-- Battery Replacement -->
    <string name="battery_replacement_notify_title">מומלץ להחליף את הסוללה</string>
    <string name="battery_replacement_notify_des">‏עלולה להיווצר בעיה של התחממות יתר של הסוללה. לכן, קיבולת הסוללה מצומצמת וקצב הטעינה איטי יותר. מומלץ להחליף את הסוללה. יש אפשרויות תמיכה. מידע נוסף זמין בכתובת &lt;u>g.co/pixel/6abattery&lt;/u>.</string>
    <string name="battery_replacement_early_notify_des">‏הסוללה שלך עברה 375 מחזורי טעינה. עלולה להיווצר בעיה של התחממות יתר של הסוללה. לכן, אחרי 400 מחזורי טעינה, קיבולת הסוללה מצטמצמת וקצב הטעינה איטי יותר. בשלב הזה מומלץ להחליף את הסוללה. יש אפשרויות תמיכה. מידע נוסף זמין בכתובת &lt;u>g.co/pixel/6abattery&lt;/u>.</string>
    <string name="battery_management_action">למספר מחזורי הטעינה</string>

