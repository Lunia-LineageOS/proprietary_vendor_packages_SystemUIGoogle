    <!-- Battery Warnings -->
    <string name="low_battery_notification_title">%s נותרו בסוללה</string>
    <string name="low_battery_notification_text">כדי להאריך את חיי הסוללה, צריך להפעיל את האפשרות \'חיסכון בסוללה\'</string>
    <string name="low_battery_notification_text_ebs">ניתן להפעיל את \'חיסכון משמעותי בסוללה\' כדי להאריך את חיי הסוללה</string>
    <string name="severe_battery_notification_title">%s נותרו בסוללה</string>
    <string name="severe_battery_notification_text">הפעלת המצב \'חיסכון משמעותי בסוללה\'. הפעולה הזו תשהה את כל האפליקציות הלא חיוניות</string>
    <string name="severe_battery_notification_switch_text">לעבור למצב \'חיסכון משמעותי בסוללה\'? \n\nהפעולה הזו תשהה את כל האפליקציות הלא חיוניות ואת ההתראות שלהן</string>
    <string name="severe_low_battery_dialog_switch_action_text">מעבר</string>
    <string name="extreme_low_battery_notification_title">הסוללה חלשה מאוד</string>
    <string name="extreme_low_battery_notification_text">אם הטלפון לא ייטען בקרוב, הוא יכבה</string>

    <!-- Battery Saver Confirmation Dialog -->
    <string name="saver_confirmation_dialog_title">נעים להכיר: מצב חיסכון בסוללה</string>
    <string name="saver_confirmation_dialog_subtitle">בחירת המצב לשימוש</string>
    <string name="saver_confirmation_dialog_title_standard_mode">חיסכון סטנדרטי בסוללה</string>
