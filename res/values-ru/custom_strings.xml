<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Smartspace -->
    <string name="accessibility_next_alarm">Следующий будильник сработает в %s</string>

    <!-- Ambient Indication -->
    <string name="accessibility_action_expand">Развернуть</string>
    <string name="accessibility_now_playing_container_recognition_result_content_description">Трек распознан. \"%1$s\", %2$s.</string>
    <string name="accessibility_now_playing_container_song_searching_content_description">Распознавание трека</string>
    <string name="accessibility_now_playing_like_icon">Добавить в избранное</string>
    <string name="accessibility_now_playing_play_icon">Воспроизвести в аудиоплеере по умолчанию</string>
    <string name="accessibility_now_playing_unlike_icon">Удалить из избранного</string>
    <string name="now_playing_label">Что сейчас играет?</string>

    <!-- Quick Tap -->
    <string name="columbus_bouncer_message">Чтобы завершить короткое касание, разблокируйте экран.</string>
    <string name="columbus_target_request_dialog_title">Разрешить использовать короткое касание для запуска приложения \"%1$s\"?</string>
    <string name="columbus_target_request_dialog_summary">Чтобы открыть приложение \"%1$s\", дважды коснитесь задней панели телефона. Этот параметр можно в любой момент изменить в настройках.</string>
    <string name="columbus_target_request_dialog_allow">Разрешить</string>
    <string name="columbus_target_request_dialog_deny">Не разрешать</string>

    <!-- Battery Warnings -->
    <string name="low_battery_notification_title">Осталось %s заряда батареи</string>
    <string name="low_battery_notification_text">Включите режим энергосбережения, чтобы увеличить время работы от батареи.</string>
    <string name="low_battery_notification_text_ebs">Чтобы продлить время работы от батареи, включите режим экстренного энергосбережения.</string>
    <string name="severe_battery_notification_title">Осталось %s заряда батареи</string>
    <string name="severe_battery_notification_text">Включите режим экстренного энергосбережения. Все второстепенные приложения будут приостановлены.</string>
    <string name="severe_battery_notification_switch_text">Включить режим экстренного энергосбережения? \n\nВсе второстепенные приложения и их уведомления будут приостановлены.</string>
    <string name="severe_low_battery_dialog_switch_action_text">Включить</string>
    <string name="extreme_low_battery_notification_title">Очень низкий заряд</string>
    <string name="extreme_low_battery_notification_text">Телефон выключится, если его не зарядить в ближайшее время.</string>

    <!-- Battery Saver Confirmation Dialog -->
    <string name="saver_confirmation_dialog_title">Режим энергосбережения</string>
    <string name="saver_confirmation_dialog_subtitle">Выберите подходящий вариант.</string>
    <string name="saver_confirmation_dialog_title_standard_mode">Стандартный режим энергосбережения</string>
    <string name="saver_confirmation_dialog_summary_standard_mode">Ограничивает визуальные эффекты и фоновые процессы, а также включает тёмную тему</string>
    <string name="saver_confirmation_dialog_title_extreme_mode">Режим экстренного энергосбережения</string>
    <string name="saver_confirmation_dialog_summary_extreme_mode">Делает то же, что и стандартный режим, а также приостанавливает приложения, без которых можно обойтись, и их уведомления</string>
    <string name="saver_confirmation_dialog_dismiss_text">Отмена</string>
    <string name="face_reenroll_dialog_confirm">Настроить</string>

    <!-- Adaptive Charging -->
    <string name="adaptive_charging_notify_title">Адаптивная зарядка включена</string>
    <string name="adaptive_charging_notify_des">Зарядка будет завершена к %1$s. Не прерывайте зарядку, чтобы продлить срок службы батареи.</string>
    <string name="adaptive_charging_notify_turn_off_once">Отключить один раз</string>
    <string name="adaptive_charging_time_estimate">%1$s • Адаптивная зарядка • Завершится к %2$s</string>

    <!-- Charge Limit -->
    <string name="charge_limit_discovery_notification_title">Защитите батарею во время зарядки</string>
    <string name="charge_limit_discovery_notification_text">Включите ограничение на уровень заряда, чтобы он не поднимался выше 80 %. Это защитит батарею и продлит срок ее службы. Изменить параметры функции можно в настройках.</string>
    <string name="charge_limit_discovery_notification_enable_button">Включить</string>
    <string name="battery_health_notify_learn_more">Подробнее</string>
    <string name="keyguard_indication_charging_time_charge_limit">%2$s • Зарядка завершится к %1$s</string>
    <string name="keyguard_indication_charging_time_charge_limit_v1">%2$s • Зарядится через %1$s</string>
    <string name="keyguard_indication_charging_time_reach_charge_limit">%1$s • Зарядка завершена</string>

    <!-- Battery Health Assistance -->
    <string name="pulsar_enabled_notification_title">Контроль состояния батареи включен</string>
    <string name="pulsar_enabled_notification_text">Теперь Pixel помогает поддерживать батарею устройства в рабочем состоянии. Эту функцию можно отключить в настройках.</string>
    <string name="pulsar_reminder_notification_title">Контроль состояния батареи отключен</string>
    <string name="pulsar_reminder_notification_text">Включите эту функцию, чтобы дольше поддерживать батарею устройства в рабочем состоянии.</string>

    <!-- Battery Defender -->
    <string name="temp_defender_notify_title">Зарядка ограничена для защиты батареи</string>
    <string name="temp_defender_notify_des">Батарея долгое время была теплой. Зарядка в обычном режиме возобновится, когда батарея остынет.</string>
    <string name="dwell_defender_notify_title">Зарядка приостановлена для защиты батареи</string>
    <string name="dwell_defender_notify_des">Это помогает продлить срок службы батареи при слишком долгой зарядке телефона.</string>
    <string name="defender_notify_title">Защита батареи</string>
    <string name="defender_notify_resume_charge">Всё равно зарядить</string>
    <string name="defender_post_notify_title">Зарядка была ограничена для защиты батареи</string>
    <string name="defender_post_notify_des">Чтобы продлить срок службы батареи, зарядка была ограничена с %1$s до %2$s.</string>
    <string name="dock_defender_first_run_title">Зарядка приостановлена для защиты батареи</string>
    <string name="dock_defender_first_run_des">Чтобы продлить срок службы батареи, зарядка приостанавливается на уровне 90 %, пока планшет находится на док-станции. Вы можете в любое время отключить эту функцию в настройках.</string>
    <string name="dock_defender_first_run_settings">Настройки</string>

    <!-- Incompatible Charging -->
    <string name="incompatible_charging_notify_title">Проверьте зарядное устройство</string>
    <string name="incompatible_charging_notify_des">Возможно, ваш телефон заряжается медленно или не заряжается. Чтобы ускорить процесс, используйте рекомендованные кабель и адаптер питания.</string>
    <string name="incompatible_charging_learn_more">Подробнее</string>

    <!-- Wireless Charging -->
    <string name="wireless_charging_notification_title">Беспроводная зарядка</string>
    <string name="wireless_charging_notification_text">При беспроводной зарядке энергопотребление может быть выше. Чтобы ускорить процесс и сэкономить электроэнергию, подключите проводное зарядное устройство.</string>

    <!-- Shutdown Mode -->
    <string name="shutdown_mode_screen_title">Телефон слишком нагрелся</string>
    <string name="shutdown_mode_screen_description">Телефон временно переведен в режим энергосбережения. Когда устройство охладится, этот режим будет отключен.</string>
    <string name="shutdown_mode_screen_shutdown_button_text">Выключить</string>
    <string name="shutdown_confirmation_dialog_title">Выключить телефон?</string>
    <string name="shutdown_confirmation_dialog_description">Включите его снова, когда он охладится.</string>
    <string name="shutdown_confirmation_dialog_confirm">Выключить</string>
    <string name="shutdown_confirmation_dialog_cancel">Отмена</string>
    <string name="post_shutdown_mode_dialog_title">Устройство находилось в режиме энергосбережения из-за перегрева</string>
    <string name="post_shutdown_mode_dialog_description">"Телефон охладился и работает нормально.

Возможные причины перегрева:
\t• Интенсивное использование батареи, например во время игр, навигации или просмотра видео.
\t• Скачивание или загрузка больших файлов.
\t• Нахождение устройства на солнце."</string>
    <string name="post_shutdown_mode_dialog_learn_more_button_text">Подробнее</string>

    <!-- Battery Replacement -->
    <string name="battery_replacement_notify_title">Рекомендуем заменить батарею</string>
    <string name="battery_replacement_notify_des">Емкость батареи и эффективность зарядки снижены из-за возможной проблемы с перегревом. Рекомендуем заменить батарею. Чтобы узнать больше, перейдите по ссылке &lt;u>g.co/pixel/6abattery&lt;/u>.</string>
    <string name="battery_replacement_early_notify_des">Батарея прошла 375 циклов зарядки. Когда число циклов достигнет 400, она может начать перегреваться, поэтому ее емкость и эффективность зарядки будут снижены. Рекомендуем заменить батарею. Чтобы узнать больше, перейдите по ссылке &lt;u>g.co/pixel/6abattery&lt;/u>.</string>
    <string name="battery_management_action">Посмотреть число циклов</string>

    <!-- Reverse Charging (Battery Share) -->
    <string name="charging_reverse_text">Передача заряда батареи…</string>
    <string name="low_battery_label">Низкий заряд батареи.</string>
    <string name="reverse_charging_device_name_text">Другое устройство Pixel</string>
    <string name="reverse_charging_device_providing_charge_text">%1$s передает заряд батареи (%2$s)</string>
    <string name="reverse_charging_on_notification_title">Передача заряда батареи включена</string>
    <string name="reverse_charging_title">Передача заряда батареи</string>
    <string name="too_hot_label">Перегрев Pixel</string>
    <string name="wireless_charging_label">Беспроводная зарядка…</string>

    <!-- Pixel Stand / Dreamliner -->
    <string name="accessibility_assistant_poodle">Голосовой поиск</string>
    <string name="accessibility_settings_gear">Настройки: Pixel Stand</string>
    <string name="dock_a11y_action_show_photo_text">Показать фоторамку</string>
    <string name="dock_photo_preview_text">Запуск фоторамки…</string>
    <string name="dock_promo_text">Проведите по экрану влево, чтобы применить фоторамку.</string>
