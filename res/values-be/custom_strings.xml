    <!-- Quick Tap -->
    <string name="columbus_bouncer_message">Разблакіруйце, каб выканаць хуткі дотык</string>
    <string name="columbus_target_request_dialog_title">Дазволіць хуткі дотык для адкрыцця праграмы \"%1$s\"?</string>
    <string name="columbus_target_request_dialog_summary">Двойчы дакрануцца да задняй панэлі тэлефона, каб адкрыць праграму \"%1$s\". Вы можаце змяніць гэта ў любы час у Наладах.</string>
    <string name="columbus_target_request_dialog_allow">Дазволіць</string>
    <string name="columbus_target_request_dialog_deny">Не дазваляць</string>

    <!-- Battery Warnings -->
    <string name="low_battery_notification_title">Засталося %s зараду акумулятара</string>
    <string name="low_battery_notification_text">Уключыце рэжым энергазберажэння, каб павялічыць час працы ад акумулятара</string>
    <string name="low_battery_notification_text_ebs">Уключыце рэжым экстрэмальнага энергазберажэння, каб павялічыць час працы ад акумулятара</string>
    <string name="severe_battery_notification_title">Застаецца %s зараду акумулятара</string>
    <string name="severe_battery_notification_text">Уключыце рэжым экстрэмальнага энергазберажэння. Усе другарадныя праграмы будуць прыпынены.</string>
    <string name="severe_battery_notification_switch_text">Пераключыцца ў рэжым экстрэмальнага энергазберажэння? \n\nУсе другарадныя праграмы і іх апавяшчэнні будуць прыпынены.</string>
    <string name="severe_low_battery_dialog_switch_action_text">Пераключыцца</string>
    <string name="extreme_low_battery_notification_title">Вельмі нізкі зарад акумулятара</string>
    <string name="extreme_low_battery_notification_text">Калі тэлефон не зарадзіць, ён хутка выключыцца</string>

    <!-- Battery Saver Confirmation Dialog -->
    <string name="saver_confirmation_dialog_title">Прадстаўляем рэжым энергазберажэння</string>
    <string name="saver_confirmation_dialog_subtitle">Выберыце рэжым для выкарыстання</string>
    <string name="saver_confirmation_dialog_title_standard_mode">Стандартны рэжым энергазберажэння</string>
    <string name="saver_confirmation_dialog_summary_standard_mode">Абмяжоўвае візуальныя эфекты і фонавыя працэсы, а таксама ўключае цёмную тэму.</string>
    <string name="saver_confirmation_dialog_title_extreme_mode">Рэжым экстрэмальнага энергазберажэння</string>
    <string name="saver_confirmation_dialog_summary_extreme_mode">Уключае ўсе змяненні, пералічаныя вышэй, і прыпыняе другарадныя праграмы і іх апавяшчэнні.</string>
    <string name="saver_confirmation_dialog_dismiss_text">Скасаваць</string>
    <string name="face_reenroll_dialog_confirm">Наладзіць</string>

    <!-- Adaptive Charging -->
    <string name="adaptive_charging_notify_title">Адаптыўная зарадка ўключана</string>
    <string name="adaptive_charging_notify_des">Акумулятар поўнасцю зарадзіцца да %1$s. Каб павялічыць тэрмін службы акумулятара, зарадка адбываецца паступова.</string>
    <string name="adaptive_charging_notify_turn_off_once">Выключыць адзін раз</string>
    <string name="adaptive_charging_time_estimate">%1$s • Адаптыўная зарадка • Поўнасцю зарадзіцца да %2$s</string>

    <!-- Charge Limit -->
    <string name="charge_limit_discovery_notification_title">Абараніце акумулятар падчас зарадкі</string>
    <string name="charge_limit_discovery_notification_text">Абмяжуйце зарад акумулятара да 80%, каб абараніць яго стан і прадоўжыць тэрмін службы. Кіраваць гэтай функцыяй можна ў наладах.</string>
    <string name="charge_limit_discovery_notification_enable_button">Уключыць</string>
    <string name="battery_health_notify_learn_more">Даведацца больш</string>
    <string name="keyguard_indication_charging_time_charge_limit">%2$s • Зарадка будзе завершана да %1$s</string>
    <string name="keyguard_indication_charging_time_charge_limit_v1">%2$s • Зарадка будзе завершана праз %1$s</string>
    <string name="keyguard_indication_charging_time_reach_charge_limit">%1$s • Зарадка завершана</string>

    <!-- Battery Health Assistance -->
    <string name="pulsar_enabled_notification_title">Дапамога па стане акумулятара ўключана</string>
    <string name="pulsar_enabled_notification_text">Цяпер тэлефон Pixel дапамагае кіраваць станам і прадукцыйнасцю акумулятара ў доўгатэрміновай перспектыве. Гэту функцыю можна адключыць у наладах.</string>
    <string name="pulsar_reminder_notification_title">Дапамога па стане акумулятара выключана</string>
    <string name="pulsar_reminder_notification_text">Уключыце дапамогу па стане акумулятара, каб забяспечыць аптымальны стан і прадукцыйнасць акумулятара ў доўгатэрміновай перспектыве.</string>

    <!-- Battery Defender -->
    <string name="temp_defender_notify_title">Зарадка абмежавана, каб абараніць акумулятар</string>
    <string name="temp_defender_notify_des">Акумулятар заставаўся нагрэтым працяглы перыяд часу. Зарадка прадоўжыцца ў звычайным рэжыме, калі акумулятар астыне.</string>
    <string name="dwell_defender_notify_title">Зарадка прыпынена, каб абараніць акумулятар</string>
    <string name="dwell_defender_notify_des">Гэта дапамагае падоўжыць тэрмін службы акумулятара, калі тэлефон застаецца на зарадцы занадта доўга</string>
    <string name="defender_notify_title">Зберажэнне акумулятара</string>
    <string name="defender_notify_resume_charge">Усё роўна зарадзіць</string>
    <string name="defender_post_notify_title">Зарадка была абмежавана, каб абараніць акумулятар</string>
    <string name="defender_post_notify_des">У мэтах падаўжэння тэрміну службы акумулятара зарадка была абмежавана з %1$s да %2$s</string>
    <string name="dock_defender_first_run_title">Зарадка прыпынена, каб абараніць акумулятар</string>
    <string name="dock_defender_first_run_des">У мэтах падаўжэння тэрміну службы акумулятара зарадка прыпыняецца на ўзроўні 90%, пакуль планшэт падключаны да док-станцыі. Каб перавызначыць гэты параметр, перайдзіце ў налады.</string>
    <string name="dock_defender_first_run_settings">Налады</string>

    <!-- Incompatible Charging -->
    <string name="incompatible_charging_notify_title">Праверце зарадную прыладу</string>
    <string name="incompatible_charging_notify_des">Магчыма, ваш тэлефон не зараджаецца або зараджаецца павольна. Каб паскорыць зарадку, выкарыстоўвайце рэкамендаваныя кабель і адаптар.</string>
    <string name="incompatible_charging_learn_more">Даведацца больш</string>

    <!-- Wireless Charging -->
    <string name="wireless_charging_notification_title">Ідзе бесправадная зарадка</string>
    <string name="wireless_charging_notification_text">Пры бесправадной зарадцы можа расходавацца больш электраэнергіі, чым пры правадной. Каб сэканоміць электрычнасць і час, паспрабуйце выкарыстаць правадную зарадную прыладу.</string>

    <!-- Shutdown Mode -->
    <string name="shutdown_mode_screen_title">Тэлефон моцна нагрэўся</string>
    <string name="shutdown_mode_screen_description">Каб тэлефон мог астыць, ён часова пераведзены ў рэжым эканоміі зараду. Тэлефон будзе гатовы для выкарыстання, калі крыху астыне.</string>
    <string name="shutdown_mode_screen_shutdown_button_text">Выключыць</string>
    <string name="shutdown_confirmation_dialog_title">Выключыць тэлефон?</string>
    <string name="shutdown_confirmation_dialog_description">Калі тэлефон астыне, яго трэба будзе ўключыць зноў.</string>
    <string name="shutdown_confirmation_dialog_confirm">Выключыць</string>
    <string name="shutdown_confirmation_dialog_cancel">Скасаваць</string>
    <string name="post_shutdown_mode_dialog_title">Тэлефон перагрэўся і знаходзіўся ў рэжыме эканоміі зараду</string>
    <string name="post_shutdown_mode_dialog_description">"Тэлефон астыў і цяпер працуе ў звычайным рэжыме.

Тэлефон можа перагравацца ў наступных выпадках:
\t• падчас выканання дзеянняў, якія хутка расходуюць зарад акумулятара, такіх як прагляд відэа, гульні і выкарыстанне праграм навігацыі;
\t• пры спампоўванні або запампоўванні файлаў вялікага памеру;
\t• калі на тэлефон уздзейнічаюць прамыя сонечныя прамяні."</string>
    <string name="post_shutdown_mode_dialog_learn_more_button_text">Даведацца больш</string>
</resources>
