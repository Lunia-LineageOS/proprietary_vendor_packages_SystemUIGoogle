    <!-- Shutdown Mode -->
    <string name="shutdown_mode_screen_title">თქვენი ტელეფონი ზედმეტად ცხელია</string>
    <string name="shutdown_mode_screen_description">თქვენი ტელეფონი დროებით დაბალი სიმძლავრის რეჟიმშია, რათა გაგრილდეს. ის კვლავ მზად იქნება გამოსაყენებლად, როცა შედარებით გაგრილდება.</string>
    <string name="shutdown_mode_screen_shutdown_button_text">გამორთვა</string>
    <string name="shutdown_confirmation_dialog_title">გსურთ ტელეფონის გამორთვა?</string>
