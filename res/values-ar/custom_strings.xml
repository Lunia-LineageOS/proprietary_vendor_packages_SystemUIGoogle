    <!-- Smartspace -->
    <string name="accessibility_next_alarm">المنبّه التالي في %s.</string>

    <!-- Ambient Indication -->
    <string name="accessibility_action_expand">توسيع</string>
    <string name="accessibility_now_playing_container_recognition_result_content_description">تم التعرّف على الأغنية. أغنية \"%1$s\" للفنان \"%2$s\".</string>
    <string name="accessibility_now_playing_container_song_searching_content_description">جارٍ التعرّف على الأغنية</string>
    <string name="accessibility_now_playing_like_icon">الإضافة إلى المفضّلة</string>
    <string name="accessibility_now_playing_play_icon">التشغيل على مشغِّل الموسيقى التلقائي</string>
    <string name="accessibility_now_playing_unlike_icon">إزالة من المفضّلة</string>
    <string name="now_playing_label">التعرّف التلقائي على الموسيقى</string>

    <!-- Quick Tap -->
    <string name="columbus_bouncer_message">يجب فتح قفل الجهاز لإكمال النقرة السريعة.</string>
    <string name="columbus_target_request_dialog_title">هل تريد السماح لإيماءة \"النقرة السريعة\" بفتح %1$s؟</string>
    <string name="columbus_target_request_dialog_summary">انقر مرتين على ظهر الهاتف لفتح %1$s. يمكنك تغيير هذا في أي وقت من خلال الإعدادات.</string>
    <string name="columbus_target_request_dialog_allow">السماح</string>
    <string name="columbus_target_request_dialog_deny">عدم السماح</string>

    <!-- Battery Warnings -->
    <string name="low_battery_notification_title">‏يتبقّى ‎%s من طاقة البطارية</string>
    <string name="low_battery_notification_text">فعِّل ميزة \"توفير شحن البطارية\" لإطالة عمر البطارية</string>
    <string name="low_battery_notification_text_ebs">ننصحك بتفعيل ميزة \"توفير البطارية العالي\" لإطالة عمر البطارية.</string>
    <string name="severe_battery_notification_title">‏يتبقى ‎%s من طاقة البطارية</string>
    <string name="severe_battery_notification_text">فعِّل وضع \"توفير البطارية العالي\"، ما سيؤدي إلى إيقاف جميع التطبيقات غير الأساسية</string>
    <string name="severe_battery_notification_switch_text">هل تريد التبديل إلى وضع \"توفير البطارية العالي\"؟ \n\nسيؤدي هذا إلى إيقاف جميع التطبيقات غير الأساسية وإشعاراتها.</string>
    <string name="severe_low_battery_dialog_switch_action_text">تبديل</string>
    <string name="extreme_low_battery_notification_title">طاقة البطارية منخفضة جدًا</string>
    <string name="extreme_low_battery_notification_text">سيتم إيقاف تشغيل الهاتف إذا لم تشحنه قريبًا</string>

    <!-- Battery Saver Confirmation Dialog -->
    <string name="saver_confirmation_dialog_title">مرحبًا بك في \"توفير شحن البطارية\"</string>
    <string name="saver_confirmation_dialog_subtitle">اختَر الوضع الذي تريد استخدامه</string>
    <string name="saver_confirmation_dialog_title_standard_mode">توفير البطارية العادي</string>
    <string name="saver_confirmation_dialog_summary_standard_mode">يحدّ هذا الخيار من المؤثرات البصرية والأنشطة في الخلفية ويُفعِّل \"المظهر الداكن\" في حال لم يكُن مفعَّلاً.</string>
    <string name="saver_confirmation_dialog_title_extreme_mode">توفير البطارية العالي</string>
    <string name="saver_confirmation_dialog_summary_extreme_mode">يشمل جميع التغييرات المذكورة أعلاه. ويتم أيضًا إيقاف التطبيقات غير الأساسية وإشعاراتها مؤقتًا.</string>
    <string name="saver_confirmation_dialog_dismiss_text">إلغاء</string>
    <string name="face_reenroll_dialog_confirm">إعداد</string>

    <!-- Adaptive Charging -->
    <string name="adaptive_charging_notify_title">ميزة \"الشحن التكيُّفي\" مفعّلة</string>
    <string name="adaptive_charging_notify_des">سيكتمل شحن البطارية في الساعة %1$s. يجري الشحن بوتيرة ثابتة لإطالة عمر البطارية.</string>
    <string name="adaptive_charging_notify_turn_off_once">الإيقاف مرة واحدة</string>
    <string name="adaptive_charging_time_estimate">‏‫‎%1$s • جارٍ الشحن الذكي • يكتمل الشحن في الساعة %2$s</string>

    <!-- Charge Limit -->
    <string name="charge_limit_discovery_notification_title">الحفاظ على حالة البطارية أثناء الشحن</string>
    <string name="charge_limit_discovery_notification_text">جرِّب ضبط الحدّ الأقصى للشحن على نسبة ‏80% للحفاظ على حالة البطارية وإطالة عمرها. يمكنك في أي وقت إدارة هذه الميزة في الإعدادات.</string>
    <string name="charge_limit_discovery_notification_enable_button">التفعيل الآن</string>
    <string name="battery_health_notify_learn_more">مزيد من المعلومات</string>
    <string name="keyguard_indication_charging_time_charge_limit">‏‫‎%2$s • اكتمل الشحن في الساعة %1$s</string>
    <string name="keyguard_indication_charging_time_charge_limit_v1">‫%2$s • سيكتمل الشحن خلال %1$s</string>
    <string name="keyguard_indication_charging_time_reach_charge_limit">‫%1$s • تم الوصول إلى حد الشحن المطلوب</string>

    <!-- Battery Health Assistance -->
    <string name="pulsar_enabled_notification_title">ميزة \"مساعدة بشأن حالة البطارية\" مفعَّلة</string>
    <string name="pulsar_enabled_notification_text">‏يساعدك هاتف Pixel الآن في إدارة حالة البطارية وأدائها على المدى الطويل. ويمكنك إيقاف هذه الميزة من خلال \"الإعدادات\".</string>
    <string name="pulsar_reminder_notification_title">ميزة \"مساعدة بشأن حالة البطارية\" غير مفعّلة</string>
    <string name="pulsar_reminder_notification_text">يمكنك تفعيل ميزة \"مساعدة بشأن حالة البطارية\" لتسهيل إدارة حالة البطارية وأدائها على المدى الطويل</string>

    <!-- Battery Defender -->
    <string name="temp_defender_notify_title">تم إيقاف الشحن مؤقتًا لحماية البطارية</string>
    <string name="temp_defender_notify_des">لقد ارتفعت درجة حرارة البطارية لفترة طويلة. وسيتم استئناف الشحن المعتاد عندما تنخفض درجة حرارتها</string>
    <string name="dwell_defender_notify_title">الشحن معلَّق لحماية البطارية</string>
    <string name="dwell_defender_notify_des">يساعد ذلك على إطالة عمر البطارية عندما يظل هاتفك متصلاً بالشاحن لفترة طويلة</string>
    <string name="defender_notify_title">جارٍ حماية بطاريتك</string>
    <string name="defender_notify_resume_charge">استكمال الشحن على أيّ حال</string>
    <string name="defender_post_notify_title">تم إيقاف الشحن مؤقتًا لحماية البطارية</string>
    <string name="defender_post_notify_des">للمساعدة في إطالة عمر البطارية، تم إيقاف الشحن مؤقتًا من %1$s إلى %2$s</string>
    <string name="dock_defender_first_run_title">الشحن معلَّق لحماية البطارية</string>
    <string name="dock_defender_first_run_des">للمساعدة في إطالة عمر البطارية، يتم تعليق الشحن عند وصوله إلى %90 عندما يكون جهازك اللوحي مثبَّتًا على قاعدة الإرساء. انتقِل إلى \"الإعدادات\" في أي وقت للإلغاء.</string>
    <string name="dock_defender_first_run_settings">الإعدادات</string>

    <!-- Incompatible Charging -->
    <string name="incompatible_charging_notify_title">يجب فحص ملحق الشحن</string>
    <string name="incompatible_charging_notify_des">قد يتم شحن هاتفك ببطء أو لا يتم شحنه. لشحن أسرع، استخدِم كابل ومحوِّل طاقة يُنصح باستخدامهما.</string>
    <string name="incompatible_charging_learn_more">مزيد من المعلومات</string>

    <!-- Wireless Charging -->
    <string name="wireless_charging_notification_title">الشحن لاسلكيًا</string>
    <string name="wireless_charging_notification_text">قد يستخدِم الشحن اللاسلكي طاقة أكبر من الشحن السلكي. جرِّب التبديل إلى شاحن سلكي لتوفير الكهرباء والوقت.</string>

    <!-- Shutdown Mode -->
    <string name="shutdown_mode_screen_title">درجة حرارة هاتفك مرتفعة جدًا</string>
    <string name="shutdown_mode_screen_description">يعمل هاتفك مؤقتًا في وضع الطاقة المنخفضة لتبريده. وسيكون جاهزًا للاستخدام مرة أخرى بعد أن يبرد.</string>
    <string name="shutdown_mode_screen_shutdown_button_text">إطفاء</string>
    <string name="shutdown_confirmation_dialog_title">هل المطلوب إطفاء الهاتف؟</string>
    <string name="shutdown_confirmation_dialog_description">بعد أن يبرد الجهاز، يجب إعادة تشغيله.</string>
    <string name="shutdown_confirmation_dialog_confirm">إطفاء</string>
    <string name="shutdown_confirmation_dialog_cancel">إلغاء</string>
    <string name="post_shutdown_mode_dialog_title">كان هاتفك في وضع الطاقة المنخفضة بسبب ارتفاع درجة حرارته</string>
    <string name="post_shutdown_mode_dialog_description">"انخفضت درجة حرارة الهاتف وعاد إلى العمل بشكل طبيعي.

يمكن أن ترتفع درجة حرارة هاتفك بشدة عند:
\t• استخدام الأنشطة التي تستهلك طاقة البطارية بشكل كبير، مثل مشاهدة الفيديوهات، وتشغيل الألعاب، والتنقّل
\t• تنزيل ملفات كبيرة أو تحميلها
\t• التعرّض لأشعة الشمس المباشرة"</string>
    <string name="post_shutdown_mode_dialog_learn_more_button_text">مزيد من المعلومات</string>

    <!-- Battery Replacement -->
    <string name="battery_replacement_notify_title">يُنصح باستبدال البطارية</string>
    <string name="battery_replacement_notify_des">‏من المحتمل أن تسخن البطارية، لذا سيتم خفض سعتها وأداء الشحن، ويُنصح باستبدالها. خيارات الدعم متوفّرة، ويمكنك الانتقال إلى &lt;u>g.co/pixel/6abattery&lt;/u> لمعرفة المزيد من المعلومات.</string>
    <string name="battery_replacement_early_notify_des">‏لقد وصل عدد دورات شحن بطاريتك إلى 375. ومن المحتمل أن تسخن البطارية عندما تصل إلى 400 دورة شحن، لذا، سيتم خفض سعتها وأداء الشحن، ويُنصح باستبدالها. خيارات الدعم متوفّرة، ويمكنك الانتقال إلى &lt;u>g.co/pixel/6abattery&lt;/u> لمعرفة المزيد من المعلومات.</string>
    <string name="battery_management_action">الاطّلاع على عدد دورات الشحن</string>

