<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Whether to show extreme battery saver reminder -->
    <bool name="config_show_extreme_battery_saver_reminder">true</bool>

    <!-- Whether to show the battery defender notifications -->
    <bool name="config_battery_defender_warning_enabled">true</bool>

    <!-- Whether the device is a tablet, which enables dock defend -->
    <bool name="config_tablet_device">false</bool>

    <!-- Whether to show the Adaptive Charging notification -->
    <bool name="config_adaptive_charging_warning_enabled">true</bool>

    <!-- Whether to show the incompatible charger notification -->
    <bool name="config_incompatible_charging_warning_enabled">true</bool>

    <!-- Whether to show the wireless charging notification on EU devices -->
    <bool name="config_wireless_charging_warning_enabled">false</bool>

    <!-- Whether to show the charge limit discovery notification on EU devices -->
    <bool name="config_charge_limit_discovery_enabled">false</bool>

    <!-- Whether the battery health index service is enabled -->
    <bool name="config_battery_index_enabled">true</bool>

    <!-- Whether to refresh the battery health index once a day -->
    <bool name="config_battery_health_periodic_update_enabled">false</bool>

    <!-- Reverse charging (Battery Share) -->
    <bool name="config_wlc_support_enabled">false</bool>
    <bool name="config_nfc_conflict_with_wlc">false</bool>
    <bool name="config_nfc_conflict_with_usb_audio">false</bool>
    <integer-array name="config_nfc_conflict_with_usb_audio_vendorid" />
    <integer-array name="config_nfc_conflict_with_usb_audio_productid" />

    <!-- Whether to show the low light clock when docked -->
    <bool name="config_show_low_light_clock_when_docked">false</bool>
</resources>
