    <string name="extreme_low_battery_notification_title">Very low battery</string>
    <string name="extreme_low_battery_notification_text">Your phone will shut down if it’s not charged soon</string>

    <!-- Battery Saver Confirmation Dialog -->
    <string name="saver_confirmation_dialog_title">Welcome to Battery Saver</string>
    <string name="saver_confirmation_dialog_subtitle">Select the mode to use</string>
    <string name="saver_confirmation_dialog_title_standard_mode">Standard Battery Saver</string>
    <string name="saver_confirmation_dialog_summary_standard_mode">Limits visual effects and background activity. Turns on dark theme, if not already on.</string>
    <string name="saver_confirmation_dialog_title_extreme_mode">Extreme Battery Saver</string>
    <string name="saver_confirmation_dialog_summary_extreme_mode">Includes all changes listed above. Also pauses non-essential apps and their notifications.</string>
    <string name="saver_confirmation_dialog_dismiss_text">Cancel</string>
    <string name="face_reenroll_dialog_confirm">Set up</string>

    <!-- Adaptive Charging -->
    <string name="adaptive_charging_notify_title">Adaptive Charging is on</string>
    <string name="adaptive_charging_notify_des">Battery full by %1$s. Charging steadily to extend battery lifespan.</string>
    <string name="adaptive_charging_notify_turn_off_once">Turn off once</string>
    <string name="adaptive_charging_time_estimate">%1$s • Adaptive Charging • Full by %2$s</string>

    <!-- Charge Limit -->
    <string name="charge_limit_discovery_notification_title">Protect your battery during charging</string>
    <string name="charge_limit_discovery_notification_text">Try turning on the 80% limit feature to protect battery health and lifespan. You can manage this in settings anytime</string>
    <string name="charge_limit_discovery_notification_enable_button">Enable now</string>
    <string name="battery_health_notify_learn_more">Learn more</string>
    <string name="charge_limit_discovery_notification_help_url" translatable="false">https://support.google.com/pixelphone?p=eu_ecodesign_charging</string>
    <string name="keyguard_indication_charging_time_charge_limit">%2$s • Done charging by %1$s</string>
    <string name="keyguard_indication_charging_time_charge_limit_v1">%2$s • Done charging in %1$s</string>
    <string name="keyguard_indication_charging_time_reach_charge_limit">%1$s • Done charging</string>

    <!-- Battery Health Assistance -->
    <string name="pulsar_enabled_notification_title">Battery health assistance is on</string>
    <string name="pulsar_enabled_notification_text">Pixel is now helping to manage your battery\'s long term health and performance. You can turn this off in Settings.</string>
    <string name="pulsar_enabled_notification_help_url" translatable="false">https://support.google.com/pixelphone?p=battery-health</string>
    <string name="pulsar_reminder_notification_title">Battery health assistance is off</string>
    <string name="pulsar_reminder_notification_text">Turn on battery health assistance to help manage your battery\'s long term health and performance</string>

    <!-- Battery Defender -->
    <string name="temp_defender_notify_title">Charging is limited to protect battery</string>
    <string name="temp_defender_notify_des">Your battery was warm for an extended period. Normal charging will resume once your battery has cooled down further</string>
    <string name="dwell_defender_notify_title">Charging on hold to protect battery</string>
    <string name="dwell_defender_notify_des">This helps extend battery lifespan when your phone is left to charge for too long</string>
    <string name="defender_notify_title">Protecting your battery</string>
    <string name="defender_notify_resume_charge">Charge anyway</string>
    <string name="defender_notify_help_url" translatable="false">https://support.google.com/pixelphone?p=android_batterydefender</string>
    <string name="defender_post_notify_title">Charging was limited to protect battery</string>
    <string name="defender_post_notify_des">To help extend battery lifespan, charging was limited from %1$s to %2$s</string>
    <string name="dock_defender_first_run_title">Charging on hold to protect battery</string>
    <string name="dock_defender_first_run_des">To help extend battery lifespan, charging is on hold at 90% while your tablet is docked. Go to Settings anytime to override.</string>
    <string name="dock_defender_first_run_settings">Settings</string>
    <string name="dock_defender_notify_helper_url" translatable="false">https://support.google.com/googlepixeltablet/?p=extend_battery_life</string>

    <!-- Incompatible Charging -->
    <string name="incompatible_charging_notify_title">Check charging accessory</string>
    <string name="incompatible_charging_notify_des">Your phone may be charging slowly or not charging. For faster charging, use a recommended cable and adapter.</string>
    <string name="incompatible_charging_learn_more">Learn more</string>
    <string name="incompatible_charging_help_url" translatable="false">https://support.google.com/pixelphone?p=pixel_power_issues</string>

    <!-- Wireless Charging -->
    <string name="wireless_charging_notification_title">Wirelessly charging</string>
    <string name="wireless_charging_notification_text">Wireless charging may use more energy than wired charging. To save electricity and time, try switching to a wired charger.</string>
    <string name="wireless_charging_notification_help_url" translatable="false">https://support.google.com/pixelphone?p=eu_ecodesign_charging</string>

    <!-- Shutdown Mode -->
    <string name="shutdown_mode_screen_title">Your phone is too warm</string>
    <string name="shutdown_mode_screen_description">Your phone is temporarily in low power mode to cool down. It will be ready to use again once it is cooler.</string>
    <string name="shutdown_mode_screen_shutdown_button_text">Power off</string>
    <string name="shutdown_confirmation_dialog_title">Power off phone?</string>
    <string name="shutdown_confirmation_dialog_description">Once it cools down, you will need to turn it back on.</string>
    <string name="shutdown_confirmation_dialog_confirm">Power off</string>
    <string name="shutdown_confirmation_dialog_cancel">Cancel</string>
    <string name="post_shutdown_mode_dialog_title">Your phone was in a low power mode due to heat</string>
    <string name="post_shutdown_mode_dialog_description">"Your phone has cooled down and is running normally again.

Your phone can get too warm when:
\t• Using battery-intensive activities like video, gaming, and navigation
\t• Downloading or uploading large files
\t• In direct sunlight"</string>
    <string name="post_shutdown_mode_dialog_learn_more_button_text">Learn more</string>

    <!-- Battery Replacement -->
    <string name="battery_replacement_notify_title">Battery replacement recommended</string>
    <string name="battery_replacement_notify_des">Due to a potential battery overheating issue, battery capacity and charging performance are reduced, and battery replacement is recommended. Support options are available, visit &lt;u>g.co/pixel/6abattery&lt;/u> for more information.</string>
    <string name="battery_replacement_early_notify_des">Your battery is at 375 charge cycles. Due to a potential battery overheating issue, when your battery reaches 400 charge cycles the battery capacity and charging performance will be reduced and battery replacement is recommended. Support options are available, visit &lt;u>g.co/pixel/6abattery&lt;/u> for more information.</string>
    <string name="battery_management_action">See cycle count</string>
    <string name="battery_replacement_notify_help_url" translatable="false">https://g.co/pixel/6abattery</string>

