    <string name="low_battery_notification_text_ebs">Turn on Extreme Battery Saver to extend battery life</string>
    <string name="severe_battery_notification_title">%s battery left</string>
    <string name="severe_battery_notification_text">Turn on Extreme Battery Saver. This will pause all non-essential apps</string>
    <string name="severe_battery_notification_switch_text">Switch to Extreme Battery Saver? \n\nThis will pause all non-essential apps and their notifications</string>
