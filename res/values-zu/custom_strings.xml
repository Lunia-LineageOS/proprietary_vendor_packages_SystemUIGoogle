    <string name="dock_defender_first_run_title">Ukushaja kumisiwe ukuze kuvikelwe ibhethri</string>
    <string name="dock_defender_first_run_des">Ukuze sisize ekwandiseni ukuphila kwebhethri, ukushaja kuyamiswa ku-90% kuyilapho ithebulethi yakho idokhwa khona. Hamba Kumasethingi noma kunini ukukhipha.</string>
