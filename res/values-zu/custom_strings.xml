    <!-- Shutdown Mode -->
    <string name="shutdown_mode_screen_title">Ifoni yakho ifudumele kakhulu</string>
    <string name="shutdown_mode_screen_description">Ifoni yakho ikumodi yamandla aphansi okwesikhashana ukuze iphole. Izokulungela ukuphinde isetshenziswe lapho isipholile.</string>
