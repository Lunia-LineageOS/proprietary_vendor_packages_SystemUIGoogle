    <string name="shutdown_confirmation_dialog_title">Amandla efoni avaliwe?</string>
    <string name="shutdown_confirmation_dialog_description">Lapho isipholile, kuzodingeka uphinde uyivule.</string>
    <string name="shutdown_confirmation_dialog_confirm">Amandla avaliwe</string>
    <string name="shutdown_confirmation_dialog_cancel">Khansela</string>
    <string name="post_shutdown_mode_dialog_title">Ifoni yakho ibikumodi yamandla aphansi ngenxa yokushisa</string>
    <string name="post_shutdown_mode_dialog_description">"Ifoni yakho seyipholile futhi isebenza ngokwejwayelekile futhi.

Ifoni yakho ingafudumala kakhulu uma:
\t• Usebenzisa izinto ezidinga ibhethri njengevidiyo, imidlalo, nokufuna
\t• Ukudawuniloda noma ukulayisha amafayela amakhulu
\t• Elangeni ngokuqondile"</string>
    <string name="post_shutdown_mode_dialog_learn_more_button_text">Funda kabanzi</string>

    <!-- Battery Replacement -->
    <string name="battery_replacement_notify_title">Ukushintshwa kwebhethri kuyanconywa</string>
    <string name="battery_replacement_notify_des">Ngenxa yokuthi kungenzeka kube nenkinga yokushisa ngokweqile kwebhethri, umthamo webhethri kanye nesivinini sokushaja kuncishisiwe, futhi kunconywa ukuba kushintshwe ibhethri. Okungakhethwa kosekelo kuyatholakala, vakashela okuthi &lt;u>g.co/pixel/6abattery&lt;/u> ukuze uthole ulwazi olwengeziwe.</string>
    <string name="battery_replacement_early_notify_des">Ibhethri lakho lisemjikelezweni wokushaja wama-375. Ngenxa yokuthi kungase kube nenkinga yokushisha ngokweqile kwebhethri, lapho ibhethri yakho ifinyelela umjikelezo wokushaja wama-400 womthambo webhethri futhi isivinini sokushaja sizoncipha futhi kunconywa ukuba kushintshwe ibhethri. Okungakhethwa kosekelo kuyatholakala, vakashela okuthi &lt;u>g.co/pixel/6abattery&lt;/u> ukuze uthole ulwazi olwengeziwe.</string>
