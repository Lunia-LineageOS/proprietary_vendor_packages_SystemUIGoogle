    <!-- Quick Tap -->
    <string name="columbus_bouncer_message">برای تکمیل «ضربه سریع»، قفل را باز کنید</string>
    <string name="columbus_target_request_dialog_title">«ضربه سریع» اجازه دارد %1$s را باز کند؟</string>
    <string name="columbus_target_request_dialog_summary">دوبار به پشت تلفنتان تک‌ضرب بزنید تا %1$s باز شود. هرزمان خواستید می‌توانید آن را در «تنظیمات» تغییر دهید.</string>
    <string name="columbus_target_request_dialog_allow">اجازه دادن</string>
    <string name="columbus_target_request_dialog_deny">اجازه ندادن</string>

    <!-- Battery Warnings -->
    <string name="low_battery_notification_title">%s از شارژ باتری باقی مانده است</string>
    <string name="low_battery_notification_text">برای افزایش عمر باتری، «بهینه‌سازی باتری» را روشن کنید</string>
    <string name="low_battery_notification_text_ebs">«نهایت بهینه‌سازی باتری» را برای افزایش عمر باتری روشن کنید</string>
    <string name="severe_battery_notification_title">%s از شارژ باتری باقی مانده است</string>
    <string name="severe_battery_notification_text">«نهایت بهینه‌سازی باتری» را روشن کنید. با این کار همه برنامه‌های غیرضروری موقتاً متوقف خواهند شد.</string>
    <string name="severe_battery_notification_switch_text">به «نهایت بهینه‌سازی باتری» می‌روید؟ \n\nبا این کار همه برنامه‌های غیرضروری و اعلان‌هایشان موقتاً متوقف خواهد شد.</string>
    <string name="severe_low_battery_dialog_switch_action_text">عوض کردن</string>
    <string name="extreme_low_battery_notification_title">باتری خیلی ضعیف است</string>
    <string name="extreme_low_battery_notification_text">اگر تلفنتان را فوراً شارژ نکنید خاموش می‌شود</string>

    <!-- Battery Saver Confirmation Dialog -->
    <string name="saver_confirmation_dialog_title">به «بهینه‌سازی باتری» خوش آمدید</string>
    <string name="saver_confirmation_dialog_subtitle">حالت استفاده را انتخاب کنید</string>
    <string name="saver_confirmation_dialog_title_standard_mode">بهینه‌سازی باتری استاندارد</string>
    <string name="saver_confirmation_dialog_summary_standard_mode">جلوه‌های دیداری و فعالیت پس‌زمینه را محدود می‌کند. «زمینه تیره» را روشن می‌کند (اگر روشن نباشد).</string>
    <string name="saver_confirmation_dialog_title_extreme_mode">نهایت بهینه‌سازی باتری</string>
    <string name="saver_confirmation_dialog_summary_extreme_mode">شامل همه تغییرات فهرست‌شده در بالا می‌شود. همچنین برنامه‌های غیرضروری و اعلان‌هایشان را موقتاً متوقف می‌کند.</string>
    <string name="saver_confirmation_dialog_dismiss_text">لغو</string>
    <string name="face_reenroll_dialog_confirm">تنظیم</string>

    <!-- Adaptive Charging -->
    <string name="adaptive_charging_notify_title">«شارژ تطبیقی» روشن است</string>
    <string name="adaptive_charging_notify_des">شارژ باتری در ساعت %1$s کامل می‌شود. برای افزایش طول عمر باتری، شارژ پیوسته انجام می‌شود.</string>
    <string name="adaptive_charging_notify_turn_off_once">یک‌بار خاموش شود</string>
    <string name="adaptive_charging_time_estimate">‫%1$s • شارژ تطبیقی • تا %2$s کامل می‌شود</string>

    <!-- Charge Limit -->
    <string name="charge_limit_discovery_notification_title">از باتری‌تان درحین شارژ شدن محافظت کنید</string>
    <string name="charge_limit_discovery_notification_text">برای حفظ سلامت باتری و افزایش عمر آن، حداکثر شارژ را روی ۸۰٪ تنظیم کنید. هر زمان بخواهید می‌توانید این ویژگی را در تنظیمات مدیریت کنید</string>
    <string name="charge_limit_discovery_notification_enable_button">اکنون فعال شود</string>
    <string name="battery_health_notify_learn_more">بیشتر بدانید</string>
    <string name="keyguard_indication_charging_time_charge_limit">‫%2$s • شارژ تا %1$s کامل می‌شود</string>
    <string name="keyguard_indication_charging_time_charge_limit_v1">‫%2$s • %1$s تا شارژ کامل مانده است</string>
    <string name="keyguard_indication_charging_time_reach_charge_limit">‫%1$s • شارژ کامل شد</string>

    <!-- Battery Health Assistance -->
    <string name="pulsar_enabled_notification_title">دستیار سلامت باتری روشن است</string>
    <string name="pulsar_enabled_notification_text">‏‫Pixel اکنون در مدیریت عملکرد و سلامت بلندمدت باتری به شما کمک می‌کند. می‌توانید این ویژگی را در «تنظیمات» خاموش کنید.</string>
    <string name="pulsar_reminder_notification_title">«دستیار سلامت باتری» خاموش است</string>
    <string name="pulsar_reminder_notification_text">«دستیار سلامت باتری» را روشن کنید تا در مدیریت عملکرد و سلامت بلندمدت باتری به شما کمک کند</string>

    <!-- Battery Defender -->
    <string name="temp_defender_notify_title">برای محافظت از باتری، شارژ محدود شده است</string>
    <string name="temp_defender_notify_des">باتری برای مدت زیادی گرم بود. شارژ عادی پس‌از خنک شدن بیشتر باتری ازسر گرفته خواهد شد</string>
    <string name="dwell_defender_notify_title">برای محافظت از باتری، شارژ موقتاً متوقف شده است</string>
    <string name="dwell_defender_notify_des">این ویژگی وقتی تلفنتان برای مدت طولانی در شارژ باقی می‌ماند به افزایش طول عمر باتری کمک می‌کند</string>
    <string name="defender_notify_title">درحال محافظت از باتری شما</string>
    <string name="defender_notify_resume_charge">درهرصورت شارژ شود</string>
    <string name="defender_post_notify_title">برای محافظت از باتری، شارژ محدود شد</string>
    <string name="defender_post_notify_des">برای کمک به افزایش طول عمر باتری، شارژ از %1$s تا %2$s محدود شد</string>
    <string name="dock_defender_first_run_title">برای محافظت از باتری، شارژ موقتاً متوقف شده است</string>
    <string name="dock_defender_first_run_des">برای کمک به افزایش طول عمر باتری، وقتی رایانه لوحی به پایه متصل است، شارژ روی ۹۰٪ موقتاً متوقف می‌شود. هرزمان خواستید برای ملغی کردن به «تنظیمات» بروید.</string>
    <string name="dock_defender_first_run_settings">تنظیمات</string>
