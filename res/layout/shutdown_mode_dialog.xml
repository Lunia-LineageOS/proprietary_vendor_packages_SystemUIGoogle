<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="8" />

    <ImageView
        android:id="@+id/shutdown_mode_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginBottom="48dp"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/ic_device_thermostat_24"
        android:tint="@color/shutdown_mode_thermometer_icon_color" />

    <TextView
        android:id="@+id/shutdown_mode_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:fontFamily="google-sans-medium"
        android:gravity="center"
        android:text="@string/shutdown_mode_screen_title"
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:textDirection="locale"
        android:textSize="@dimen/shutdown_mode_screen_title_text_size" />

    <TextView
        android:id="@+id/shutdown_mode_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="48dp"
        android:fontFamily="google-sans-medium"
        android:gravity="center"
        android:text="@string/shutdown_mode_screen_description"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textDirection="locale"
        android:textSize="@dimen/shutdown_mode_screen_description_text_size" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="6" />

    <LinearLayout
        android:id="@+id/shutdown_button"
        android:layout_width="@dimen/global_actions_button_size"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:stateListAnimator="@anim/control_state_list_animator">

        <ImageView
            android:layout_width="@dimen/global_actions_button_size"
            android:layout_height="@dimen/global_actions_button_size"
            android:layout_marginBottom="@dimen/global_actions_grid_container_bottom_margin"
            android:background="@drawable/global_actions_lite_button"
            android:contentDescription="@null"
            android:padding="@dimen/global_actions_button_padding"
            android:scaleType="centerInside"
            android:src="@android:drawable/ic_lock_power_off"
            android:tint="@color/materialColorOnSurface" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:gravity="center"
            android:marqueeRepeatLimit="marquee_forever"
            android:text="@string/shutdown_mode_screen_shutdown_button_text"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="@color/materialColorOnSurface"
            android:textSize="@dimen/shutdown_mode_screen_shutdown_button_text_size" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4" />
</LinearLayout>
