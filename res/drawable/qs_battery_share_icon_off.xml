<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/vd_battery_share">
    <target
        android:name="path">
        <aapt:attr
            name="android:animation">
            <set
                android:ordering="sequentially">
                <objectAnimator
                    android:interpolator="@anim/ease"
                    android:duration="150"
                    android:startOffset="0"
                    android:valueFrom="@string/path_battery_share_on"
                    android:valueTo="@string/path_battery_share_left"
                    android:valueType="pathType"
                    android:propertyName="pathData"/>
                <objectAnimator
                    android:interpolator="@anim/overshoot"
                    android:duration="500"
                    android:startOffset="0"
                    android:valueFrom="@string/path_battery_share_left"
                    android:valueTo="@string/path_battery_share_on"
                    android:valueType="pathType"
                    android:propertyName="pathData"/>
            </set>
        </aapt:attr>
    </target>
</animated-vector>
