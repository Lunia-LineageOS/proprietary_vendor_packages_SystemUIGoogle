    <!-- Charge Limit -->
    <string name="charge_limit_discovery_notification_title">Chroń baterię podczas ładowania</string>
    <string name="charge_limit_discovery_notification_text">Spróbuj włączyć funkcję ograniczenia ładowania do 80%, aby chronić żywotność baterii. W każdej chwili możesz to zmienić w ustawieniach.</string>
    <string name="charge_limit_discovery_notification_enable_button">Włącz teraz</string>
    <string name="battery_health_notify_learn_more">Więcej informacji</string>
