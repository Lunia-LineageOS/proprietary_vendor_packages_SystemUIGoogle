    <string name="keyguard_indication_charging_time_charge_limit_v1">%2$s • Koniec ładowania za %1$s</string>
    <string name="keyguard_indication_charging_time_reach_charge_limit">%1$s • Koniec ładowania</string>

    <!-- Battery Health Assistance -->
    <string name="pulsar_enabled_notification_title">Włączono zarządzanie stanem baterii</string>
    <string name="pulsar_enabled_notification_text">Pixel pomaga teraz zarządzać stanem i wydajnością baterii w ujęciu długoterminowym. Możesz to wyłączyć w Ustawieniach.</string>
    <string name="pulsar_reminder_notification_title">Wyłączono zarządzanie stanem baterii</string>
    <string name="pulsar_reminder_notification_text">Włącz zarządzanie stanem baterii, aby sterować nim i wydajnością w ujęciu długoterminowym.</string>

    <!-- Battery Defender -->
    <string name="temp_defender_notify_title">Ładowanie jest ograniczone w celu ochrony baterii</string>
    <string name="temp_defender_notify_des">Bateria była ciepła przez dłuższy czas. Normalne ładowanie zostanie wznowione, gdy schłodzi się ona jeszcze bardziej</string>
    <string name="dwell_defender_notify_title">Wstrzymano ładowanie, aby chronić baterię</string>
    <string name="dwell_defender_notify_des">Pomaga wydłużyć żywotność baterii, gdy telefon jest zbyt długo ładowany</string>
    <string name="defender_notify_title">Ochrona baterii</string>
    <string name="defender_notify_resume_charge">Ładuj mimo to</string>
    <string name="defender_post_notify_title">Ładowanie zostało ograniczone w celu ochrony baterii</string>
    <string name="defender_post_notify_des">W celu wydłużenia żywotności baterii ładowanie było ograniczone od %1$s do %2$s</string>
    <string name="dock_defender_first_run_title">Wstrzymano ładowanie, aby chronić baterię</string>
    <string name="dock_defender_first_run_des">Gdy tablet będzie zadokowany, ładowanie zostanie wstrzymane na poziomie 90%, aby zwiększyć żywotność baterii. W każdej chwili możesz to wyłączyć w Ustawieniach.</string>
    <string name="dock_defender_first_run_settings">Ustawienia</string>

    <!-- Incompatible Charging -->
    <string name="incompatible_charging_notify_title">Sprawdź akcesoria do ładowania</string>
    <string name="incompatible_charging_notify_des">Telefon może ładować się powoli lub w ogóle się nie ładować. Aby ładować szybciej, użyj zalecanego kabla i ładowarki.</string>
    <string name="incompatible_charging_learn_more">Więcej informacji</string>

    <!-- Wireless Charging -->
    <string name="wireless_charging_notification_title">Ładowanie bezprzewodowe</string>
    <string name="wireless_charging_notification_text">Ładowanie bezprzewodowe może zużywać więcej energii niż przewodowe. Aby oszczędzać energię i czas, używaj ładowarki przewodowej.</string>

    <!-- Shutdown Mode -->
    <string name="shutdown_mode_screen_title">Telefon jest zbyt ciepły</string>
    <string name="shutdown_mode_screen_description">Telefon jest tymczasowo w trybie oszczędzania baterii, aby się schłodzić. Będzie można z niego znowu korzystać, gdy jego temperatura spadnie.</string>
    <string name="shutdown_mode_screen_shutdown_button_text">Wyłącz</string>
    <string name="shutdown_confirmation_dialog_title">Wyłączyć telefon?</string>
    <string name="shutdown_confirmation_dialog_description">Gdy się schłodzi, trzeba będzie go ponownie włączyć.</string>
    <string name="shutdown_confirmation_dialog_confirm">Wyłącz</string>
    <string name="shutdown_confirmation_dialog_cancel">Anuluj</string>
    <string name="post_shutdown_mode_dialog_title">Telefon działał w trybie oszczędzania baterii z powodu przegrzania</string>
    <string name="post_shutdown_mode_dialog_description">"Temperatura telefonu spadła i znów działa on normalnie.

Temperatura telefonu może wzrastać, gdy:
\t• znacznie obciążasz baterię, na przykład oglądając filmy, grając czy korzystając z nawigacji;
\t• pobierasz lub przesyłasz duże pliki;
\t• urządzenie jest wystawione na słońce."</string>
    <string name="post_shutdown_mode_dialog_learn_more_button_text">Więcej informacji</string>

    <!-- Battery Replacement -->
    <string name="battery_replacement_notify_title">Zalecana wymiana baterii</string>
    <string name="battery_replacement_notify_des">Ze względu na potencjalny problem z przegrzewaniem się baterii jej pojemność i wydajność ładowania zostały ograniczone. Zalecamy wymianę baterii. Dostępne są opcje pomocy. Więcej informacji znajdziesz na stronie &lt;u>g.co/pixel/6abattery&lt;/u>.</string>
    <string name="battery_replacement_early_notify_des">Bateria osiągnęła 375 cykli ładowania. Po osiągnięciu 400 cykli jej pojemność i wydajność ładowania zostaną ograniczone ze względu na potencjalny problem z przegrzewaniem się. Zalecamy wówczas wymianę baterii. Dostępne są opcje pomocy. Więcej informacji znajdziesz na stronie &lt;u>g.co/pixel/6abattery&lt;/u>.</string>
    <string name="battery_management_action">Zobacz liczbę cykli</string>

