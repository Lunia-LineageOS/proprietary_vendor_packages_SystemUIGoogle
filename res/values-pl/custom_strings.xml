    <!-- Battery Saver Confirmation Dialog -->
    <string name="saver_confirmation_dialog_title">Oszczędzanie baterii</string>
    <string name="saver_confirmation_dialog_subtitle">Wybierz tryb, którego chcesz użyć</string>
    <string name="saver_confirmation_dialog_title_standard_mode">Standardowe oszczędzanie baterii</string>
    <string name="saver_confirmation_dialog_summary_standard_mode">Ogranicza efekty wizualne i aktywność w tle. Włącza ciemny motyw, jeśli jeszcze z niego nie korzystasz.</string>
    <string name="saver_confirmation_dialog_title_extreme_mode">Maksymalne oszczędzanie baterii</string>
    <string name="saver_confirmation_dialog_summary_extreme_mode">Obejmuje wszystkie zmiany wymienione wyżej. Ponadto wstrzymuje aplikacje, które nie są niezbędne, oraz ich powiadomienia.</string>
    <string name="saver_confirmation_dialog_dismiss_text">Anuluj</string>
    <string name="face_reenroll_dialog_confirm">Skonfiguruj</string>

    <!-- Adaptive Charging -->
    <string name="adaptive_charging_notify_title">Włączono ładowanie adaptacyjne</string>
