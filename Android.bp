android_library {
    name: "sysuig_monolith",
    srcs: [
        "src/**/*.kt",
        "src/**/*.java",
        "src/**/*.aidl",
    ],
    use_resource_processor: true,
    resource_dirs: [
        "res",
        "res-keyguard",
    ],
    manifest: "AndroidManifest-res.xml",
    libs: [
        "keepanno-annotations",
    ],
    kotlincflags: [
        "-Xjvm-default=all",
        "-opt-in=kotlinx.coroutines.ExperimentalCoroutinesApi",
        "-P plugin:androidx.compose.compiler.plugins.kotlin:sourceInformation=true",
    ],
    plugins: [
        "androidx.room_room-compiler-plugin",
        "dagger2-compiler",
    ],
    static_libs: [
        "SystemUI-core",
        "android.frameworks.stats-V2-java",
        "androidx.compose.runtime_runtime",
        "columbus-lib",
        "columbus-proto-java",
        "googlebattery-lib",
        "reversecharging-lib",
        "smartspace-proto-java",
        "smartspace-proto-lite-java",
        "tensorflowlite_java",
    ],
    enable_ksp: true,
}

android_app {
    name: "SystemUIGoogle",
    defaults: [
        "platform_app_defaults",
        "SystemUI_optimized_defaults",
        "wmshell_defaults",
    ],
    static_libs: [
        "sysuig_phone"
    ],
    jni_libs: ["libtensorflowlite_jni"],
    use_embedded_native_libs: true,
    resource_dirs: [],
    asset_dirs: ["assets"],
    additional_manifests: ["LineageManifest.xml"],
    aaptflags: [
        "-0 .tflite",
        "-0 .vocab",
    ],
    enable_ksp: true,

    use_resource_processor: true,
    platform_apis: true,
    system_ext_specific: true,
    certificate: "platform",
    privileged: true,

    kotlincflags: ["-Xjvm-default=all"],

    dxflags: ["--multi-dex"],
    optimize: {
        proguard_flags_files: ["proguard.flags"],
        included_proguard_flags_files: [
            ":sysui_proguard_common_and_kotlin",
        ],
    },
    required: [
        "privapp_whitelist_com.android.systemui",
    ],

    overrides: [
        "SystemUI",
    ],
}
